{
  "name": "code-academy-desk",
  "version": "0.1.0",
  "description": "Code Academy Desk —— 教材驱动的桌面端编程学习工作台",
  "main": "./out/main/index.js",
  "author": "Code Academy Desk",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke",
    "test": "vitest run",
    "build:plugin": "node scripts/build-course-tools.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "build:bridge": "node scripts/build-bridge-libs.mjs"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "konva": "^10.9.1",
    "matter-js": "^0.20.0",
    "react-konva": "^19.3.2",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.12",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.44.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "mafs": "^0.21.0",
    "mermaid": "^12.3.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
